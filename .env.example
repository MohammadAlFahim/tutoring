# ===========================================================================
# Course AI Study Assistant — environment variables
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
# On Vercel, add the same keys under Project Settings → Environment Variables.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. UNIT CONFIG (the three values that define your deployment)
# ---------------------------------------------------------------------------
# The unit this assistant tutors. Shown in the UI and used to filter retrieval.
NEXT_PUBLIC_UNIT="Data Structures and Algorithms COMP2007"
# University name (used in the tutor prompt and UI).
NEXT_PUBLIC_UNIVERSITY="Curtin University"
# The ONLY account that can open /admin/analytics.
ADMIN_EMAIL="alfahim2179@gmail.com"
# Only emails on this domain (plus ADMIN_EMAIL) may sign up. Keep the leading "@".
# IMPORTANT: also update the seeded values in supabase/migrations/0001_init.sql
# (the app_config table) — the DB enforces this independently.
NEXT_PUBLIC_ALLOWED_STUDENT_DOMAIN="@student.curtin.edu.au"

# ---------------------------------------------------------------------------
# 2. SUPABASE  (https://supabase.com → Project Settings → API)
#    Create the project in the Sydney region (ap-southeast-2).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Service role key — SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------------------------------------------------
# 3. ANTHROPIC  (https://console.anthropic.com → API Keys)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model overrides (defaults shown):
# CHAT_MODEL="claude-sonnet-4-6"
# DEEP_MODEL="claude-opus-4-8"
# QUIZ_MODEL="claude-sonnet-4-6"

# ---------------------------------------------------------------------------
# 4. VOYAGE AI  (https://www.voyageai.com → Dashboard → API Keys)
#    Used for embeddings (voyage-3-large) and reranking (rerank-2).
# ---------------------------------------------------------------------------
VOYAGE_API_KEY="pa-..."
# Optional overrides (defaults shown):
# EMBEDDING_MODEL="voyage-3-large"
# EMBEDDING_DIM="1024"          # MUST match vector(N) in the SQL migration
# RERANK_MODEL="rerank-2"

# ---------------------------------------------------------------------------
# 5. OPENAI  (https://platform.openai.com → API Keys)
#    Used ONLY by the local ingestion script to transcribe lecture recordings.
#    Not needed by the deployed app.
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
# TRANSCRIBE_MODEL="whisper-1"  # needs segment timestamps; keep whisper-1

# ---------------------------------------------------------------------------
# 6. OPTIONAL
# ---------------------------------------------------------------------------
# Dedicated secret for signing quiz answer tokens (recommended in production).
# Generate one with:  openssl rand -hex 32
# QUIZ_SIGNING_SECRET="..."
#
# Chat rate limit (per user). Defaults: 20 questions / 60s.
# RATE_LIMIT_MAX="20"
# RATE_LIMIT_WINDOW_SECONDS="60"
