# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env files (NEVER commit secrets)
.env
.env.local
.env*.local

# course materials (do not commit copyrighted lecture content / large media),
# but keep the folder structure (README + .gitkeep) in git.
/course-materials/*
!/course-materials/README.md
!/course-materials/slides
!/course-materials/notes
!/course-materials/recordings
!/course-materials/textbooks
/course-materials/slides/*
/course-materials/notes/*
/course-materials/recordings/*
/course-materials/textbooks/*
!/course-materials/slides/.gitkeep
!/course-materials/notes/.gitkeep
!/course-materials/recordings/.gitkeep
!/course-materials/textbooks/.gitkeep

# ingestion cache
/.ingest-cache

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
